{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sendme-app",
  "compatibility_date": "2026-01-16",
  "observability": {
    "enabled": true,
  },
  "main": "./.output/server/index.mjs",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./.output/public",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sendme-db",
      "database_id": "4419bd4c-8798-4ff3-b2ca-6d4ea3345be9",
      "migrations_dir": "./drizzle",
    },
  ],
  "vars": {
    "CLERK_SECRET_KEY": "sk_test_dev-key",
    "CLERK_PUBLISHABLE_KEY": "pk_test_dev-key",
    "VITE_CLERK_PUBLISHABLE_KEY": "pk_test_dev-key",
  },
  "env": {
    "production": {
      "vars": {
        "CLERK_SECRET_KEY": "",
        "CLERK_PUBLISHABLE_KEY": "",
        "VITE_CLERK_PUBLISHABLE_KEY": "",
      },
    },
  },
  "dev": {
    "port": 8788,
  },
}
