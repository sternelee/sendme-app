{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "allowJs": true,
    "noEmit": true,
    "strict": true,
    "types": ["vinxi/types/client", "@cloudflare/workers-types"],
    "isolatedModules": true,
    "paths": {
      "~/*": ["./src/*"],
      "@sendme/ui": ["../packages/ui/src/index.ts"],
      "@sendme/ui/*": ["../packages/ui/src/*"],
      "@sendme/shared": ["../packages/shared/src/index.ts"]
    },
    "moduleDetection": "force"
  }
}
