# Clerk Configuration for Local Development
# Copy this file to .dev.vars and update with your actual credentials

# Clerk Publishable Key (starts with pk_test_ or pk_live_)
# Get from https://clerk.com -> Applications -> API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key

# Clerk Secret Key (starts with sk_test_ or sk_live_)
# Get from https://clerk.com -> Applications -> API Keys
CLERK_SECRET_KEY=sk_test_your-secret-key

# Clerk JWT Key (optional, for verifying JWTs)
# Get from https://clerk.com -> Applications -> JWT Templates
CLERK_JWT_KEY=your-jwt-key
