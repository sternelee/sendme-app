{
  "identifier": "main",
  "description": "permissions for desktop app",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "dialog:default",
    "dialog:allow-ask",
    "dialog:allow-message",
    "core:event:allow-listen",
